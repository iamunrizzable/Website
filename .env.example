# TikTok Open Platform credentials (from developers.tiktok.com)
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=https://tjbmanagementinc.com/auth/tiktok/callback

# TikTok Business API credentials (from business-api.tiktok.com)
TIKTOK_BUSINESS_APP_ID=your_business_app_id
TIKTOK_BUSINESS_SECRET=your_business_secret
TIKTOK_BUSINESS_REDIRECT_URI=https://tjbmanagementinc.com/auth/tiktok/business/callback

# Admin panel credentials — set both in Vercel Environment Variables
ADMIN_USERNAME=your_username_here
ADMIN_SECRET=your_strong_secret_here

# Secret for Vercel Cron Job authentication — generate with: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# Groq API key (free tier) for the Hallie writer tool (/hallie/writer) —
# get one at console.groq.com
GROQ_API_KEY=your_groq_api_key

# Local Chromium path for dev (leave blank on Vercel — it uses @sparticuz/chromium automatically)
# Mac: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/chromium-browser
CHROMIUM_PATH=

# Vercel KV (add KV store in Vercel dashboard → Storage → KV, then pull env)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Email alerts via SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tyler@tjbmanagementinc.com
SMTP_PASS=your_gmail_app_password
