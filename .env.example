# TikTok Open Platform credentials (from developers.tiktok.com)
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=https://tjbmanagementinc.com/auth/tiktok/callback

# TikTok Business API credentials (from business-api.tiktok.com)
TIKTOK_BUSINESS_APP_ID=your_business_app_id
TIKTOK_BUSINESS_SECRET=your_business_secret
TIKTOK_BUSINESS_REDIRECT_URI=https://tjbmanagementinc.com/auth/tiktok/business/callback
# Optional — defaults to TIKTOK_BUSINESS_REDIRECT_URI with /business/callback
# swapped for /account-callback if unset. See lib/tiktok/business-oauth.js.
TIKTOK_ACCOUNT_REDIRECT_URI=

# Optional — Business Portal OAuth start URLs (see lib/tiktok/business-oauth.js
# getBusinessAuthUrl / getTikTokAccountAuthUrl). If unset, the code builds
# the URL itself from the app ID + redirect URI above — only set these if
# using TikTok's Business Portal flow with a state param TikTok pre-fills.
TIKTOK_ADVERTISER_AUTHORIZATION_URL=
TIKTOK_ACCOUNT_AUTHORIZATION_URL=

# Optional — pre-stored advertiser token (JSON) to skip the advertiser OAuth
# flow entirely. See lib/tokens.js and the "Copy this value" instructions on
# /admin/internal/hallie/tiktok-moderation/system.
TIKTOK_ADVERTISER_TOKEN=

# Admin panel credentials — set both in Vercel Environment Variables
ADMIN_USERNAME=your_username_here
ADMIN_SECRET=your_strong_secret_here

# Secret for Vercel Cron Job authentication — generate with: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# Groq API key (free tier) for the Hallie writer tool (/hallie/writer) —
# get one at console.groq.com. This is the default brain (no cost, no
# Anthropic key). To point Hallie at a different LLM later — e.g. a
# self-hosted Ollama box — set HALLIE_LLM_URL / HALLIE_LLM_MODEL /
# HALLIE_LLM_KEY instead; see lib/hallie-llm.js.
GROQ_API_KEY=your_groq_api_key
# HALLIE_LLM_URL=
# HALLIE_LLM_MODEL=
# HALLIE_LLM_KEY=

# iCloud IMAP credentials for the Tyler-persona voice import (Sent folder
# only — see lib app/api/hallie/voice-import/email/route.js). Use an
# Apple app-specific password (appleid.apple.com → Sign-In and Security
# → App-Specific Passwords), never the actual iCloud account password.
ICLOUD_EMAIL_ADDRESS=tyler@tjbmanagementinc.com
ICLOUD_APP_PASSWORD=your_apple_app_specific_password

# Optional — canonical site origin used to build OAuth redirect URLs
# (lib/site-url.js). Defaults to https://tjbmanagementinc.com in production
# and http://localhost:3000 in dev, so this is only needed to override that.
SITE_URL=

# Local Chromium path for dev (leave blank on Vercel — it uses @sparticuz/chromium automatically)
# Mac: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/chromium-browser
CHROMIUM_PATH=

# Upstash Redis, for persistent OAuth token storage (lib/tokens.js) — without
# these, tokens fall back to in-memory + cookie storage only (see CLAUDE.md
# "Token Persistence"). Get these from a free Upstash Redis database
# (console.upstash.com, or Vercel dashboard → Storage → add Upstash), then
# copy the REST URL/token — NOT the old Vercel KV variable names, which this
# code does not read.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email alerts via SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tyler@tjbmanagementinc.com
SMTP_PASS=your_gmail_app_password

# Fingerprint device intelligence (docs.fingerprint.com). Note the exact
# names below — Vercel's Fingerprint integration provisions these WITHOUT
# the NEXT_PUBLIC_ prefix, so they must be read server-side (see
# app/layout.js) and passed down as props; process.env access from client
# code only auto-inlines NEXT_PUBLIC_-prefixed vars.
NEXT_FPJS_PUBLIC_API_KEY=JAY7LolFtp7YSFykq0uE
NEXT_FPJS_REGION=us

# Fingerprint Server API secret key (dashboard → API keys → Server API tab —
# NOT the Public key above, and NOT the "Sealed Client" tab, which is a
# different feature). Used server-side only (app/api/fingerprint/check) to
# evaluate identification events against the "Assess mobile device risk
# (iOS)" ruleset (rs_4ns6PcOeU2RspQ) and decide whether to block a visitor.
# Never exposed to the client.
FINGERPRINT_SERVER_API_KEY=your_fingerprint_server_api_key
